```html
<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#111827">
  <title>Rekap Peserta Hadir</title>

  <style>
    * {
      box-sizing: border-box;
    }

    html, body {
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100%;
      font-family: Arial, Helvetica, sans-serif;
      background: #f3f4f6;
      color: #111827;
    }

    body {
      display: flex;
      flex-direction: column;
      min-height: 100vh;
    }

    header {
      background: #111827;
      color: #fff;
      padding: 14px 18px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      box-shadow: 0 2px 10px rgba(0,0,0,.12);
    }

    .title {
      min-width: 0;
    }

    .title h1 {
      margin: 0;
      font-size: 20px;
    }

    .title p {
      margin: 4px 0 0;
      font-size: 12px;
      opacity: .8;
    }

    .refresh-btn {
      border: 0;
      border-radius: 10px;
      background: #fff;
      color: #111827;
      padding: 10px 14px;
      font-size: 14px;
      font-weight: 700;
      cursor: pointer;
    }

    main {
      flex: 1;
      padding: 12px;
      min-height: 0;
    }

    .sheet-container {
      width: 100%;
      height: 100%;
      min-height: calc(100vh - 92px);
      background: #fff;
      border-radius: 14px;
      overflow: hidden;
      box-shadow: 0 2px 12px rgba(0,0,0,.08);
    }

    iframe {
      display: block;
      width: 100%;
      height: 100%;
      min-height: calc(100vh - 92px);
      border: 0;
    }

    @media (max-width: 600px) {
      header {
        padding: 12px;
      }

      .title h1 {
        font-size: 17px;
      }

      .title p {
        font-size: 11px;
      }

      .refresh-btn {
        padding: 9px 11px;
        font-size: 13px;
      }

      main {
        padding: 6px;
      }

      .sheet-container,
      iframe {
        min-height: calc(100vh - 78px);
        border-radius: 10px;
      }
    }
  </style>
</head>

<body>

  <header>
    <div class="title">
      <h1>📋 Rekap Peserta Hadir</h1>
      <p>Data kehadiran peserta</p>
    </div>

    <button class="refresh-btn" onclick="refreshSheet()">
      🔄 Refresh
    </button>
  </header>

  <main>
    <div class="sheet-container">
      <iframe
        id="rekapSheet"
        src="https://docs.google.com/spreadsheets/d/e/2PACX-1vQ5bRWeuGKZcMXkvzhXrPM8NBmDaa7ElASji2r6zdL07C0IrSXbJcm2aistHoSJTwKWgsfhFv8RRMTH/pubhtml?gid=1324163518&single=true&widget=true&headers=false"
        title="Rekap Peserta Hadir"
        loading="lazy">
      </iframe>
    </div>
  </main>

  <script>
    function refreshSheet() {
      const iframe = document.getElementById("rekapSheet");

      const baseUrl =
        "https://docs.google.com/spreadsheets/d/e/2PACX-1vQ5bRWeuGKZcMXkvzhXrPM8NBmDaa7ElASji2r6zdL07C0IrSXbJcm2aistHoSJTwKWgsfhFv8RRMTH/pubhtml?gid=1324163518&single=true&widget=true&headers=false";

      iframe.src =
        baseUrl + "&refresh=" + Date.now();
    }
  </script>

</body>
</html>
